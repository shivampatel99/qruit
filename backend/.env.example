# Copy to backend/.env and fill in as real credentials arrive. Everything
# below is safe to leave blank/default for mock mode (see README.md).
#
# IMPORTANT: for a field you're leaving blank, do not put a comment on the
# same line after "KEY=" — python-dotenv only strips a trailing "# ..."
# comment when there's a real value before it. On a genuinely blank line,
# the comment text itself gets read as the value, which then silently
# fools config validation into thinking the credential is set. Comments
# for blank fields go on the line above instead, as below.

# --- Server secret & host --------------------------------------------------
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
QRUIT_APPROVAL_SECRET=
QRUIT_PUBLIC_BASE_URL=http://localhost:8787   # stable HTTPS host in production; see §11 NW-1

# --- Mock switches (true = safe to run with zero live credentials) --------
QRUIT_EMAIL_MOCK=true                 # false routes mail through the connected Gmail/Outlook mailbox
QRUIT_MOCK_API=true                   # false calls the live Reqruit.ai deep-screening API
QRUIT_INTERVIEW_MOCK=true             # false calls the live Reqruit.ai interview API
WHATSAPP_MOCK=true                    # false sends real WhatsApp messages via Meta's Cloud API

# --- Google Workspace (Gmail + Drive) — §3/§4 GM-3, GD-2 -------------------
# Google Cloud Console > APIs & Services > Credentials (OAuth client ID)
GOOGLE_CLIENT_ID=
# same OAuth client, "client secret" field
GOOGLE_CLIENT_SECRET=
# optional default folder id, from the Drive folder's URL
GOOGLE_DRIVE_FOLDER_ID=

# --- Microsoft 365 (Outlook + SharePoint/OneDrive) — §5/§6 MS-1..3, SP-1/2 -
# Entra ID > App registrations > Overview > Application (client) ID
MS_CLIENT_ID=
# Entra ID > Certificates & secrets > client secret value
MS_CLIENT_SECRET=
# Entra ID > Overview > Directory (tenant) ID
MS_TENANT=
# GET /sites/{host}:/sites/{path} via Graph Explorer; empty = OneDrive
SHAREPOINT_SITE_ID=
# folder path relative to the default document library root
SHAREPOINT_FOLDER_PATH=

# --- WhatsApp Business (Meta Cloud API) — §8 WA-2, WA-4, WA-6 --------------
# Business settings > System users > permanent access token
WHATSAPP_TOKEN=
# WhatsApp Manager > Phone numbers > API Setup > Phone number ID
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token  # any string you choose; also entered in the Meta app's webhook config
# Meta app dashboard > Settings > Basic > App Secret (signs webhook payloads)
WHATSAPP_APP_SECRET=

# --- Reqruit.ai — §9 RQ-1/RQ-2 ----------------------------------------------
# issued by the Reqruit.ai platform owners
REQRUIT_AUTH_TOKEN=
REQRUIT_BASE_URL=https://deep-screening.reqruit.ai
INTERVIEW_BASE_URL=https://interview.reqruit.ai

# --- Misc --------------------------------------------------------------
DEFAULT_SLA_HOURS=48                  # hours before a pending checkpoint triggers a status_update reminder
