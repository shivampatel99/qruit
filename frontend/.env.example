# Must NOT be "localhost" — the backend's PublicHostnameGuardMiddleware
# deliberately rejects /api/* requests whose Host header matches
# QRUIT_PUBLIC_BASE_URL's hostname (localhost by default in backend/.env),
# reserving /api/* for internal/VPN access only (see app/observability.py).
# 127.0.0.1 is a different hostname as far as that check is concerned, so
# use it for local frontend development.
VITE_API_BASE_URL=http://127.0.0.1:8787
